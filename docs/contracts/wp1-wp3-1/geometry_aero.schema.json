{
  "$defs": {
    "AeroStation": {
      "additionalProperties": false,
      "properties": {
        "chord_m": {
          "exclusiveMinimum": 0,
          "title": "Chord M",
          "type": "number"
        },
        "leading_edge_surface_m": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Leading Edge Surface M",
          "type": "array"
        },
        "polar_asset_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Polar Asset Id",
          "type": "string"
        },
        "span_or_radius_m": {
          "minimum": 0,
          "title": "Span Or Radius M",
          "type": "number"
        },
        "twist_rad": {
          "title": "Twist Rad",
          "type": "number"
        }
      },
      "required": [
        "span_or_radius_m",
        "chord_m",
        "twist_rad",
        "leading_edge_surface_m",
        "polar_asset_id"
      ],
      "title": "AeroStation",
      "type": "object"
    },
    "Frames": {
      "additionalProperties": false,
      "properties": {
        "angles": {
          "const": "rad",
          "default": "rad",
          "title": "Angles",
          "type": "string"
        },
        "body": {
          "const": "right_handed_x_forward_y_left_z_up",
          "default": "right_handed_x_forward_y_left_z_up",
          "title": "Body",
          "type": "string"
        },
        "quaternion": {
          "const": "wxyz_body_to_world",
          "default": "wxyz_body_to_world",
          "title": "Quaternion",
          "type": "string"
