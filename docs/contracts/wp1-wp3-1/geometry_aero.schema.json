          "title": "World",
          "type": "string"
        }
      },
      "title": "Frames",
      "type": "object"
    },
    "GeometryAsset": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "path": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "role": {
          "enum": [
            "exact_geometry",
            "display_mesh",
            "drawing",
            "parametric_source"
          ],
