        "envelope": {
          "$ref": "#/$defs/PolarEnvelope"
        },
        "evidence_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Sha256"
        },
        "moment_reference": {
          "const": "quarter_chord",
          "default": "quarter_chord",
