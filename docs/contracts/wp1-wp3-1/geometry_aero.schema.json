          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "path",
        "sha256",
        "role"
      ],
      "title": "GeometryAsset",
      "type": "object"
    },
    "PolarEnvelope": {
      "additionalProperties": false,
