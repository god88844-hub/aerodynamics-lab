      "title": "Density Kg M3",
      "type": "number"
    },
    "force_body_n": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Force Body N",
      "type": "array"
    },
    "moment_body_nm": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Moment Body Nm",
      "type": "array"
    },
    "moment_datum_body_m": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Moment Datum Body M",
      "type": "array"
    },
    "physical_validation_status": {
      "const": "unvalidated",
      "default": "unvalidated",
      "title": "Physical Validation Status",
      "type": "string"
    },
    "relative_air_velocity_body_m_s": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Relative Air Velocity Body M S",
      "type": "array"
    },
    "solver": {
      "$ref": "#/$defs/Solver"
    },
    "surface_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Surface Sha256",
      "type": "string"
    },
    "time_s": {
      "minimum": 0,
      "title": "Time S",
      "type": "number"
    }
