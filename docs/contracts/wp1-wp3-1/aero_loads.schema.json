  "required": [
    "surface_sha256",
    "solver",
    "time_s",
    "relative_air_velocity_body_m_s",
    "density_kg_m3",
    "force_body_n",
    "moment_body_nm",
    "moment_datum_body_m"
  ],
  "title": "AeroLoads",
  "type": "object"
}
