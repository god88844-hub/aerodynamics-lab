[configuration]
entry_symbol = "lab_library_init"
compatibility_minimum = "4.5"

[libraries]
windows.debug.x86_64 = "res://bin/lab_engineering.dll"
windows.release.x86_64 = "res://bin/lab_engineering.dll"
linux.debug.x86_64 = "res://bin/liblab_engineering.so"
linux.release.x86_64 = "res://bin/liblab_engineering.so"
macos.debug = "res://bin/liblab_engineering.macos.framework"
macos.release = "res://bin/liblab_engineering.macos.framework"
android.debug.arm64 = "res://bin/liblab_engineering.android.arm64.so"
android.release.arm64 = "res://bin/liblab_engineering.android.arm64.so"
ios.release = "res://bin/liblab_engineering.ios.xcframework"
